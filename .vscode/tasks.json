{
  "version": "2.0.0",
  "tasks": [
    // RUN ANY CRUNCHY APP'S DESKTOP VERSION from this window (crunchyCore tools/run-app.mjs; crunchyTile TILE-DESIGN.md
    // §113): `cargo run` on that app's working tree, uncommitted changes included. One terminal per app, so several can
    // run at once; closing the app's window ends its task. A first build takes a few minutes.
    {
      "label": "Run desktop: CrunchyTile",
      "type": "shell",
      "command": "node \"${workspaceFolder}/../crunchyCore/tools/run-app.mjs\" tile",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run desktop: CrunchyUI",
      "type": "shell",
      "command": "node \"${workspaceFolder}/../crunchyCore/tools/run-app.mjs\" ui",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run desktop: CrunchySFX",
      "type": "shell",
      "command": "node \"${workspaceFolder}/../crunchyCore/tools/run-app.mjs\" sfx",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run desktop: CrunchyVFX",
      "type": "shell",
      "command": "node \"${workspaceFolder}/../crunchyCore/tools/run-app.mjs\" vfx",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run desktop: CrunchyBGM",
      "type": "shell",
      "command": "node \"${workspaceFolder}/../crunchyCore/tools/run-app.mjs\" bgm",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run desktop: CrunchyCharacter",
      "type": "shell",
      "command": "node \"${workspaceFolder}/../crunchyCore/tools/run-app.mjs\" character",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run desktop: CrunchyItems",
      "type": "shell",
      "command": "node \"${workspaceFolder}/../crunchyCore/tools/run-app.mjs\" items",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run desktop: CrunchyShader",
      "type": "shell",
      "command": "node \"${workspaceFolder}/../crunchyCore/tools/run-app.mjs\" shader",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // crunchyCore first, then this app (crunchyTile TILE-DESIGN.md §111): shows what changed in crunchyCore, runs its
      // tests, asks for the CORE's commit message and a yes, commits and pushes the core, then pulls it in here.
      // This app is never committed by it: commit it afterwards as usual. The script is a core file (tools/core-commit.mjs).
      "label": "Commit crunchyCore, then pull it here",
      "type": "shell",
      "command": "node tools/core-commit.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true }
    },
    {
      // crunchyCore, then EVERY app (crunchyCore tools/core-sync.mjs, AJ 2026-10-12): commits and pushes the core, then in
      // Tile, UI, SFX, VFX and BGM pulls it and commits ONLY what the pull changed (the copies, the hook, index.html's
      // wants), with the core's message. Your own changes in each app stay uncommitted; an app with anything already
      // staged is skipped. Asks once whether to push the apps too. CrunchyCharacter (Dowel's) is left out.
      "label": "Commit crunchyCore and every app",
      "type": "shell",
      "command": "node \"${workspaceFolder}/../crunchyCore/tools/core-sync.mjs\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true }
    },
    {
      // Static file server for the web version. Used as the preLaunchTask for the
      // "Web app (localhost)" / "Web app (Chrome/Edge)" launch configs; the background matcher
      // below is what tells VS Code the server is up (python prints "Serving HTTP ..." once and
      // then never again, so beginsPattern and endsPattern are the same line).
      "label": "Web: serve",
      "type": "shell",
      "command": "python3 -u -m http.server 5173",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP",
          "endsPattern": "Serving HTTP"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      // Hot-reloading desktop dev. Needs the Tauri CLI: cargo install tauri-cli --version "^2"
      // Edits to index.html/*.js are picked up because build.rs re-copies them into dist/ and
      // declares cargo:rerun-if-changed on each one.
      "label": "Desktop: tauri dev",
      "type": "shell",
      "command": "cargo tauri dev",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
