{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrunchyVFX",
  "version": "0.1.0",
  "identifier": "com.crunchyvfx.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CrunchyVFX — sprite VFX generator",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "GraphicsAndDesign",
    "shortDescription": "A from-scratch sprite VFX generator.",
    "longDescription": "Design, breed and export animated 2D sprite effects — explosions, magic, impacts, weather — as sprite sheets, PNG frames, GIF or APNG. Effects you make are CC0 (public domain).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
