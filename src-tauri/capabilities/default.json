{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core defaults plus export (Save dialog + write), drag-out (native drag of a temp sheet PNG into the OS / an engine), and the planted Library (VFX-DESIGN §18: read, list, write and remove its own files inside crunchy/vfx/ in the chosen folder).",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-remove",
    "drag:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*.sevi66.workers.dev/*"
        },
        {
          "url": "https://sevi66.itch.io/*"
        },
        {
          "url": "https://crunchytile.com/*"
        },
        {
          "url": "https://crunchyui.com/*"
        },
        {
          "url": "https://crunchysfx.com/*"
        },
        {
          "url": "https://crunchyvfx.com/*"
        },
        {
          "url": "https://crunchybgm.com/*"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$PICTURE/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    }
  ]
}
